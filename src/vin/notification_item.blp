using Gtk 4.0;

template $VinNotificationItem: Gtk.Grid {
  row-spacing: 0;
  column-spacing: 0;

  Gtk.Label summary {
    xalign: 0;

    layout {
      row: 0;
      column: 0;
    }
  }

  Gtk.Label body {
    xalign: 0;

    layout {
      row: 1;
      column: 0;
    }
  }

  Gtk.Image app_icon {
    layout {
      row: 2;
      column: 1;
    }
  }

  Gtk.Label app_name {
    xalign: 0;

    layout {
      row: 2;
      column: 2;
    }
  }
}
